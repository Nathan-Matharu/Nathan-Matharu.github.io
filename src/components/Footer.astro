<script>
  const DATA_URL = "https://raw.githubusercontent.com/Nathan-Matharu/Web-Ring/main/webring.json";

  // Helper to ensure URLs are absolute so they do not resolve relative to the current site path
  function formatAbsoluteUrl(url) {
    if (!url) return "#";
    const cleanUrl = url.trim();
    if (!/^https?:\/\//i.test(cleanUrl) && !cleanUrl.startsWith("//")) {
      return "https://" + cleanUrl;
    }
    return cleanUrl;
  }

  async function initWebring() {
    try {
      const response = await fetch(DATA_URL);
      if (!response.ok) {
        throw new Error(`Failed to fetch webring data: ${response.statusText}`);
      }
      const sites = await response.json();
      if (!Array.isArray(sites) || sites.length === 0) {
        return;
      }
      
      // Get the current site's URL origin (e.g., "https://matharu.work")
      const currentOrigin = window.location.origin.toLowerCase();
      
      // Find the index of the current site in the webring array
      const currentIndex = sites.findIndex(site => {
        if (!site || !site.url) return false;
        const siteUrl = site.url.toLowerCase();
        return siteUrl.includes(currentOrigin) || currentOrigin.includes(siteUrl);
      });
      
      let prevSite, nextSite;

      if (currentIndex === -1) {
        console.log("This site isn't registered in the webring layout yet. Using default links.");
        // Fallback: If not found, use first and last
        prevSite = sites[sites.length - 1];
        nextSite = sites[0];
      } else {
        // Math to handle wrapping around the array seamlessly
        const prevIndex = (currentIndex - 1 + sites.length) % sites.length;
        const nextIndex = (currentIndex + 1) % sites.length;
        prevSite = sites[prevIndex];
        nextSite = sites[nextIndex];
      }

      // Inject the links into the HTML containers
      const prevEl = document.getElementById("webring-prev");
      const nextEl = document.getElementById("webring-next");
      if (prevEl && nextEl) {
        prevEl.href = formatAbsoluteUrl(prevSite.url);
        prevEl.innerText = `← ${prevSite.name}`;
        nextEl.href = formatAbsoluteUrl(nextSite.url);
        nextEl.innerText = `${nextSite.name} →`;
      }
      
    } catch (error) {
      console.error("Error loading webring data:", error);
    }
  }

  // Astro scripts run after the DOM is ready by default
  initWebring();
</script>
