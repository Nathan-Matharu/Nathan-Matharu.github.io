---
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.replace(/\/$/, ""); // remove trailing slash

const navItems = [
  { href: "/", label: "Homepage" },
  { href: "/projects", label: "Projects" },
  { href: "/publications", label: "Publications" }
];

import { Image } from 'astro:assets';
import icon from '../assets/img/Website.png';
---

<header class="site-header" id="site-header">
  <div class="wrapper">
    <a class="site-title" href="/" id="logo-link">
      <Image src={icon} alt="Nathan Logo" width={45} priority />
      <span class="title">Nathan Matharu</span>  
    </a>

    <nav class="site-nav" id="main-navigation">
      <div class="trigger">
        {navItems.map(item => {
          const isActive = currentPath === item.href || (item.href !== "/" && currentPath.startsWith(item.href));
          return (
            <a 
              class={`page-link ${isActive ? 'active' : ''}`} 
              href={item.href}
              id={`nav-link-${item.label.toLowerCase()}`}
            >
              {item.label}
            </a>
          );
        })}
      </div>
    </nav>
  </div>
</header>
